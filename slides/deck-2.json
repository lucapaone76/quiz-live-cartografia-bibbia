\" x2=\"71.3\" y1=\"99.7\" y2=\"92.0\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"2\" x1=\"96.8\" x2=\"81.2\" y1=\"96.8\" y2=\"81.2\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"99.7\" x2=\"92.0\" y1=\"80.5\" y2=\"71.3\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"110.5\" x2=\"103.6\" y1=\"72.2\" y2=\"62.4\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"122.0\" x2=\"116.0\" y1=\"64.9\" y2=\"54.5\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"134.1\" x2=\"129.0\" y1=\"58.6\" y2=\"47.7\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"146.6\" x2=\"142.5\" y1=\"53.4\" y2=\"42.1\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"159.6\" x2=\"156.5\" y1=\"49.3\" y2=\"37.7\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"172.9\" x2=\"170.8\" y1=\"46.4\" y2=\"34.6\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"186.4\" x2=\"185.4\" y1=\"44.6\" y2=\"32.6\"></line>\n<g transform=\"rotate(45 200 200)\"><polygon fill=\"var(--gold,#b8892e)\" points=\"200,92 187,187 200,200\"></polygon><polygon fill=\"#d9b869\" points=\"200,92 213,187 200,200\"></polygon></g>\n<g transform=\"rotate(135 200 200)\"><polygon fill=\"var(--gold,#b8892e)\" points=\"200,92 187,187 200,200\"></polygon><polygon fill=\"#d9b869\" points=\"200,92 213,187 200,200\"></polygon></g>\n<g transform=\"rotate(225 200 200)\"><polygon fill=\"var(--gold,#b8892e)\" points=\"200,92 187,187 200,200\"></polygon><polygon fill=\"#d9b869\" points=\"200,92 213,187 200,200\"></polygon></g>\n<g transform=\"rotate(315 200 200)\"><polygon fill=\"var(--gold,#b8892e)\" points=\"200,92 187,187 200,200\"></polygon><polygon fill=\"#d9b869\" points=\"200,92 213,187 200,200\"></polygon></g>\n<g transform=\"rotate(0 200 200)\"><polygon fill=\"var(--navy,#14284b)\" points=\"200,50 181,181 200,200\"></polygon><polygon fill=\"#3d5784\" points=\"200,50 219,181 200,200\"></polygon></g>\n<g transform=\"rotate(90 200 200)\"><polygon fill=\"var(--navy,#14284b)\" points=\"200,50 181,181 200,200\"></polygon><polygon fill=\"#3d5784\" points=\"200,50 219,181 200,200\"></polygon></g>\n<g transform=\"rotate(180 200 200)\"><polygon fill=\"var(--navy,#14284b)\" points=\"200,50 181,181 200,200\"></polygon><polygon fill=\"#3d5784\" points=\"200,50 219,181 200,200\"></polygon></g>\n<g transform=\"rotate(270 200 200)\"><polygon fill=\"var(--navy,#14284b)\" points=\"200,50 181,181 200,200\"></polygon><polygon fill=\"#3d5784\" points=\"200,50 219,181 200,200\"></polygon></g>\n<circle cx=\"200\" cy=\"200\" fill=\"var(--paper,#f6efdc)\" r=\"27\" stroke=\"var(--navy,#14284b)\" stroke-width=\"3\"></circle>\n<path d=\"M200 214 C184 203 176 194 176 185 C176 177 183 172 190 172 C195 172 198 175 200 179 C202 175 205 172 210 172 C217 172 224 177 224 185 C224 194 216 203 200 214 Z\" fill=\"var(--brick,#8c2f2f)\" transform=\"translate(200 200) scale(.62) translate(-200 -194)\"></path>\n<text fill=\"var(--navy,#14284b)\" font-family=\"var(--serif,'EB Garamond',serif)\" font-size=\"28\" font-weight=\"700\" text-anchor=\"middle\" x=\"200\" y=\"20\">N</text>\n<text fill=\"var(--navy,#14284b)\" font-family=\"var(--serif,'EB Garamond',serif)\" font-size=\"28\" font-weight=\"700\" text-anchor=\"middle\" x=\"384\" y=\"209\">E</text>\n<text fill=\"var(--navy,#14284b)\" font-family=\"var(--serif,'EB Garamond',serif)\" font-size=\"28\" font-weight=\"700\" text-anchor=\"middle\" x=\"200\" y=\"398\">S</text>\n<text fill=\"var(--navy,#14284b)\" font-family=\"var(--serif,'EB Garamond',serif)\" font-size=\"28\" font-weight=\"700\" text-anchor=\"middle\" x=\"16\" y=\"209\">O</text>\n</svg></figure>\n<h1>Come approcciare il testo biblico</h1>\n<h2>Cartografia della Parola — seconda parte</h2>\n<blockquote>\n<p>Lasciarsi colpire dal testo, collocarlo nel suo contesto, lasciare che la Scrittura spieghi la Scrittura, approfondire le parole</p>\n</blockquote>\n<p>Dalla prima lettura alla preghiera, con esempi dal Vangelo</p></div><footer><span>Cartografia della Parola</span><span>1 / 10</span></footer></section>"}, {"n": 2, "title": "1. Leggere due volte e lasciarsi colpire", "steps": 4, "quiz": null, "html": "<section class=\"slide layout-cards cols-3\" data-n=\"2\" style=\"--cols:3;--fs:28px\"><h2 class=\"slide-title\">1. Leggere due volte e lasciarsi colpire</h2><div class=\"body\"><p class=\"frag\" data-f=\"1\"><strong class=\"lead\">Prima di leggere</strong>\nUn breve momento di silenzio. Pregare lo Spirito Santo di saperLo ascoltare e di aprire il cuore.</p>\n<p class=\"frag\" data-f=\"2\"><strong class=\"lead\">Prima lettura</strong>\nLeggere il brano per intero, con calma.</p>\n<p class=\"frag\" data-f=\"3\"><strong class=\"lead\">Seconda lettura</strong>\nFermarsi e <strong>sottolineare o segnarsi la frase che risuona di più</strong>, la parte che attira e colpisce.</p>\n<blockquote class=\"frag\" data-f=\"4\">\n<p><strong>Esempio — Luca 5,1-11.</strong> Dopo una notte senza pesca, Pietro dice a Gesù: <em>«sulla tua parola getterò le reti»</em> (Lc 5,5). Se è questa la frase che mi colpisce, parto da lì per approfondire.</p>\n</blockquote></div><footer><span>Cartografia della Parola</span><span>2 / 10</span></footer></section>"}, {"n": 3, "title": "Per approfondire ciò che ci ha colpito: tre vie", "steps": 4, "quiz": null, "html": "<section class=\"slide layout-cards cols-3\" data-n=\"3\" style=\"--cols:3;--fs:30px\"><h2 class=\"slide-title\">Per approfondire ciò che ci ha colpito: tre vie</h2><div class=\"body\"><p class=\"frag\" data-f=\"1\"><strong class=\"lead\">1. Il contesto</strong>\nChe cosa c'è prima e dopo il brano? Il contesto storico, geografico, sociale e biblico.</p>\n<p class=\"frag\" data-f=\"2\"><strong class=\"lead\">2. I passi paralleli</strong>\nDove, altrove nella Bibbia, si dice la stessa cosa?</p>\n<p class=\"frag\" data-f=\"3\"><strong class=\"lead\">3. Le parole</strong>\nLe spiegazioni, una traduzione letterale, le parole greche.</p>\n<blockquote class=\"frag\" data-f=\"4\">\n<p>Per approfondire la parte che ci ha colpito possiamo fare una di queste tre cose.</p>\n</blockquote></div><footer><span>Cartografia della Parola</span><span>3 / 10</span></footer></section>"}, {"n": 4, "title": "2. Il contesto: prima e dopo il brano", "steps": 3, "quiz": null, "html": "<section class=\"slide layout-cards cols-2\" data-n=\"4\" style=\"--cols:2;--fs:28px\"><h2 class=\"slide-title\">2. Il contesto: prima e dopo il brano</h2><div class=\"body\"><p class=\"frag\" data-f=\"1\"><strong class=\"lead\">Leggere prima e dopo</strong>\nLeggere il testo biblico, il Vangelo in modo particolare, <strong>immediatamente prima e immediatamente dopo</strong>, per capire in che contesto quella cosa viene detta o fatta. La comprensione aumenta molto.</p>\n<p class=\"frag\" data-f=\"2\"><strong class=\"lead\">Esempio — Matteo 18,21-35</strong>\nPietro chiede quante volte perdonare e Gesù risponde: «fino a settanta volte sette». Prima (18,15-20) c'è la correzione fraterna; dopo (18,23-35) la parabola del servo spietato, che ne spiega il senso.</p>\n<blockquote class=\"frag\" data-f=\"3\">\n<p>Si perdona perché si è stati perdonati.</p>\n</blockquote></div><footer><span>Cartografia della Parola</span><span>4 / 10</span></footer></section>"}, {"n": 5, "title": "Il contesto più ampio: storia, luoghi, società, Bibbia", "steps": 4, "quiz": null, "html": "<section class=\"slide layout-table\" data-n=\"5\" style=\"--fs:24px\"><h2 class=\"slide-title\">Il contesto più ampio: storia, luoghi, società, Bibbia</h2><div class=\"body\"><p>Serve a capire bene l'impatto, e a volte la <strong>rivoluzionarietà</strong>, di ciò che Gesù fa.</p>\n<table>\n<thead>\n<tr>\n<th></th>\n<th><strong>Il brano</strong></th>\n<th><strong>Che cosa ci fa capire</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr class=\"frag\" data-f=\"1\">\n<td><strong>Storico</strong></td>\n<td data-label=\"Il brano\">Mc 12,13-17, il tributo a Cesare</td>\n<td data-label=\"Che cosa ci fa capire\">La Giudea è sotto dominio romano e pagare il tributo era per molti un segno dell'occupazione: rispondere sì o no era una trappola.</td>\n</tr>\n<tr class=\"frag\" data-f=\"2\">\n<td><strong>Geografico</strong></td>\n<td data-label=\"Il brano\">Lc 10,30, l'uomo che «scendeva da Gerusalemme a Gerico»</td>\n<td data-label=\"Che cosa ci fa capire\">La strada scende di circa mille metri, attraversa il deserto ed è nota per i briganti.</td>\n</tr>\n<tr class=\"frag\" data-f=\"3\">\n<td><strong>Sociale</strong></td>\n<td data-label=\"Il brano\">Gv 4,1-30, la samaritana al pozzo</td>\n<td data-label=\"Che cosa ci fa capire\">Giudei e samaritani non avevano rapporti (4,9) e i discepoli si meravigliano che Gesù parli con una donna (4,27): un gesto rivoluzionario.</td>\n</tr>\n<tr class=\"frag\" data-f=\"4\">\n<td><strong>Biblico</strong></td>\n<td data-label=\"Il brano\">Gv 4,6, il pozzo di Giacobbe</td>\n<td data-label=\"Che cosa ci fa capire\">Nella Bibbia al pozzo nascono i fidanzamenti: Rebecca (Gen 24), Rachele (Gen 29), Sippòra (Es 2,15-21). Gesù è lo sposo che cerca la sua sposa.</td>\n</tr>\n</tbody>\n</table></div><footer><span>Cartografia della Parola</span><span>5 / 10</span></footer></section>"}, {"n": 6, "title": "3. Altrove nella Bibbia: i passi paralleli", "steps": 3, "quiz": null, "html": "<section class=\"slide layout-table cols-2\" data-n=\"6\" style=\"--cols:2;--fs:27px\"><h2 class=\"slide-title\">3. Altrove nella Bibbia: i passi paralleli</h2><div class=\"body\"><p>Quali passi <strong>rafforzano o chiariscono</strong> quello che sto leggendo ed <strong>evitano i fraintendimenti</strong>, inevitabili nel linguaggio umano?</p>\n<table>\n<thead>\n<tr>\n<th><strong>Letto da solo</strong></th>\n<th><strong>Chiarito da un altro passo</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr class=\"frag\" data-f=\"1\">\n<td data-label=\"Letto da solo\">«Chiedete e vi sarà dato» (Mt 7,7): una promessa senza condizioni?</td>\n<td data-label=\"Chiarito da un altro passo\">Il Padre darà lo Spirito Santo a chi glielo chiede (Lc 11,13); la richiesta è legata al rimanere in Gesù e nelle sue parole (Gv 15,7).</td>\n</tr>\n<tr class=\"frag\" data-f=\"2\">\n<td data-label=\"Letto da solo\">«Odiare» padre e madre (Lc 14,26, nel testo greco)</td>\n<td data-label=\"Chiarito da un altro passo\">«Chi ama padre o madre più di me, non è degno di me» (Mt 10,37): non è odio, è mettere Gesù al primo posto.</td>\n</tr>\n<tr class=\"frag\" data-f=\"3\">\n<td data-label=\"Letto da solo\">«Porgi l'altra guancia» (Mt 5,39): subire in silenzio?</td>\n<td data-label=\"Chiarito da un altro passo\">Gesù, schiaffeggiato, chiede ragione del colpo ricevuto (Gv 18,22-23): la non-violenza non è passività.</td>\n</tr>\n</tbody>\n</table></div><footer><span>Cartografia della Parola</span><span>6 / 10</span></footer></section>"}, {"n": 7, "title": "4. Approfondire: traduzione letterale e parole greche", "steps": 3, "quiz": null, "html": "<section class=\"slide layout-cards cols-2\" data-n=\"7\" style=\"--cols:2;--fs:27px\"><h2 class=\"slide-title\">4. Approfondire: traduzione letterale e parole greche</h2><div class=\"body\"><p class=\"frag\" data-f=\"1\"><strong class=\"lead\">Traduzione letterale — Matteo 5,3</strong>\n«Poveri in spirito» traduce <em>ptōchoi tō pneumati</em>. <em>Ptōchos</em> (G4434) è il povero ridotto a mendicare, che dipende interamente dagli altri. Letteralmente: «beati i mendicanti nello spirito».</p>\n<p class=\"frag\" data-f=\"2\"><strong class=\"lead\">Parole greche — Giovanni 21,15-17</strong>\nGesù chiede a Pietro «mi ami?» con <em>agapaō</em> (G25) e Pietro risponde con <em>phileō</em> (G5368); la terza volta Gesù usa il verbo di Pietro. In italiano resta sempre «amare» e la sfumatura si perde.</p>\n<blockquote class=\"frag\" data-f=\"3\">\n<p>Sulla frase che mi ha colpito: cercare i passi paralleli, le spiegazioni, una traduzione letterale e, con internet, le parole greche — per esempio su <a href=\"https://www.blueletterbible.org\" rel=\"noopener\" target=\"_blank\">Blue Letter Bible</a>.</p>\n</blockquote></div><footer><span>Cartografia della Parola</span><span>7 / 10</span></footer></section>"}, {"n": 8, "title": "5. Dalla lettura alla preghiera", "steps": 4, "quiz": null, "html": "<section class=\"slide layout-steps\" data-n=\"8\" style=\"--fs:23px\"><h2 class=\"slide-title\">5. Dalla lettura alla preghiera</h2><div class=\"body\"><p>Dopo aver letto e approfondito, la Parola diventa preghiera e vita</p>\n<ol>\n<li class=\"frag\" data-f=\"1\"><strong class=\"lead\">Meditazione (Meditatio)</strong>Chiedi a Gesù di mettere in evidenza una parte della lettura. Cosa significa questo passo per me?</li>\n<li class=\"frag\" data-f=\"2\"><strong class=\"lead\">Preghiera (Oratio)</strong>Gesù, cosa vuoi che io sappia di questo passo? Aspetta che parli nei tuoi pensieri, immaginazione, voce interiore o sentimenti.</li>\n<li class=\"frag\" data-f=\"3\"><strong class=\"lead\">Contemplazione (Contemplatio)</strong>Chiedi a Gesù di riempirti della sua presenza e amore. Ringrazia Dio per il vostro tempo insieme!</li>\n<li class=\"frag\" data-f=\"4\"><strong class=\"lead\">Azione (Actio)</strong>Gesù, cosa vuoi che io faccia con quello che mi hai donato? Scegli un gesto concreto. Nei giorni successivi tieni un diario di ciò che il Signore ti dice, per farne tesoro e rileggerlo.</li>\n</ol></div><footer><span>Cartografia della Parola</span><span>8 / 10</span></footer></section>"}, {"n": 9, "title": "Chiusura", "steps": 0, "quiz": null, "html": "<section class=\"slide layout-closing\" data-n=\"9\"><div class=\"body\"><figure class=\"art\"><svg aria-label=\"Bussola con il cuore al centro\" role=\"img\" viewbox=\"0 0 400 400\" xmlns=\"http://www.w3.org/2000/svg\">\n<circle cx=\"200\" cy=\"200\" fill=\"none\" r=\"168\" stroke=\"var(--navy,#14284b)\" stroke-width=\"3\"></circle>\n<circle cx=\"200\" cy=\"200\" fill=\"none\" r=\"156\" stroke=\"