{"deck": 2, "title": "Come approcciare il testo biblico", "pages": [{"n": 1, "title": "Titolo", "steps": 0, "quiz": null, "html": "<section class=\"slide layout-title\" data-n=\"1\"><div class=\"body\"><figure class=\"art\"><svg aria-label=\"Bussola con il cuore al centro\" role=\"img\" viewbox=\"0 0 400 400\" xmlns=\"http://www.w3.org/2000/svg\">\n<circle cx=\"200\" cy=\"200\" fill=\"none\" r=\"168\" stroke=\"var(--navy,#14284b)\" stroke-width=\"3\"></circle>\n<circle cx=\"200\" cy=\"200\" fill=\"none\" r=\"156\" stroke=\"var(--gold,#b8892e)\" stroke-dasharray=\"2 5\" stroke-width=\"1.5\"></circle>\n<circle cx=\"200\" cy=\"200\" fill=\"none\" opacity=\".45\" r=\"112\" stroke=\"var(--navy,#14284b)\" stroke-width=\"1\"></circle>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"2\" x1=\"200.0\" x2=\"200.0\" y1=\"54.0\" y2=\"32.0\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"213.6\" x2=\"214.6\" y1=\"44.6\" y2=\"32.6\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"227.1\" x2=\"229.2\" y1=\"46.4\" y2=\"34.6\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"240.4\" x2=\"243.5\" y1=\"49.3\" y2=\"37.7\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"253.4\" x2=\"257.5\" y1=\"53.4\" y2=\"42.1\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"265.9\" x2=\"271.0\" y1=\"58.6\" y2=\"47.7\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"278.0\" x2=\"284.0\" y1=\"64.9\" y2=\"54.5\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"289.5\" x2=\"296.4\" y1=\"72.2\" y2=\"62.4\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"300.3\" x2=\"308.0\" y1=\"80.5\" y2=\"71.3\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"2\" x1=\"303.2\" x2=\"318.8\" y1=\"96.8\" y2=\"81.2\"></line>\n<line stroke=\"var(--navy,#14284b)\" stroke-width=\"1\" x1=\"319.5\" x2=\"328.7\" y1=\"99.7\" y2=\"92.0\"></lin